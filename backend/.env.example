PORT=5001
CLIENT_URLS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/voklance?replicaSet=rs0
# Set true to send verification emails and require verification for new accounts.
EMAIL_VERIFICATION_ENABLED=false
APP_PUBLIC_URL=http://localhost:5173
# Optional: configure all three settings below and a running SMTP service to enable password reset and email change.
# EMAIL_FROM=no-reply@localhost.test
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_HOURLY_LIMIT=5
EMAIL_RESEND_IP_HOURLY_LIMIT=20
# Minimum wait after decline, cancellation, or removal before the same pair can request again.
CONNECTION_REREQUEST_COOLDOWN_HOURS=168
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_SYNC_COOLDOWN_MINUTES=5
